<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="petnaly_followup_view_search" model="ir.ui.view">
        <field name="name">petnaly.followup.search</field>
        <field name="model">petnaly.followup</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="buyer_id"/>
                <field name="animal_id"/>
                <field name="user_id"/>
                <filter name="my" string="My Follow-ups" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="pending" string="To Do" domain="[('state', '=', 'pending')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="due_today" string="Due Today"
                        domain="[('due_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_user" string="Assigned To" context="{'group_by': 'user_id'}"/>
                <filter name="group_buyer" string="Customer" context="{'group_by': 'buyer_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="petnaly_followup_view_list" model="ir.ui.view">
        <field name="name">petnaly.followup.list</field>
        <field name="model">petnaly.followup</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state in ('done', 'cancelled')">
                <field name="due_date"/>
                <field name="name"/>
                <field name="buyer_id"/>
                <field name="buyer_phone" optional="show"/>
                <field name="animal_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'pending'"/>
                <field name="is_overdue" column_invisible="1"/>
                <button name="action_done" type="object" string="Done"
                        icon="fa-check" invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="petnaly_followup_view_form" model="ir.ui.view">
        <field name="name">petnaly.followup.form</field>
        <field name="model">petnaly.followup</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset" type="object" string="Reset"
                            invisible="state == 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="buyer_id"/>
                            <field name="buyer_phone" widget="phone"/>
                            <field name="buyer_email" widget="email"/>
                        </group>
                        <group string="Task">
                            <field name="animal_id"/>
                            <field name="reservation_id"/>
                            <field name="user_id"/>
                            <field name="due_date"/>
                            <field name="is_overdue" invisible="1"/>
                            <field name="done_date" invisible="state != 'done'"/>
                        </group>
                    </group>
                    <group string="Talking Points">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="petnaly_followup_action" model="ir.actions.act_window">
        <field name="name">Customer Follow-ups</field>
        <field name="res_model">petnaly.followup</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="petnaly_followup_view_search"/>
        <field name="context">{'search_default_my': 1, 'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No follow-ups yet</p>
            <p>Follow-up tasks are created automatically when a puppy is sold. Call or message the customer, then mark each task done.</p>
        </field>
    </record>

</odoo>
