<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="petget_followup_view_list_template" model="ir.ui.view">
        <field name="name">petget.followup.template.list</field>
        <field name="model">petget.followup.template</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="offset_days"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="petget_followup_view_form_template" model="ir.ui.view">
        <field name="name">petget.followup.template.form</field>
        <field name="model">petget.followup.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Welcome call"/></h1>
                    </div>
                    <group>
                        <field name="offset_days"/>
                        <field name="active"/>
                    </group>
                    <group string="Talking Points">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="petget_followup_action_template" model="ir.actions.act_window">
        <field name="name">Follow-up Templates</field>
        <field name="res_model">petget.followup.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
