<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="petget_followup_view_form_reservation" model="ir.ui.view">
        <field name="name">petget.reservation.form.followup</field>
        <field name="model">petget.reservation</field>
        <field name="inherit_id" ref="petget_buyer_sale.petget_buyer_sale_view_form_reservation"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_followups" type="object"
                        string="Generate Follow-ups" invisible="followup_generated"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="followup_generated" invisible="1"/>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_followups" type="object"
                            class="oe_stat_button" icon="fa-phone">
                        <field name="followup_count" widget="statinfo" string="Follow-ups"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
