<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="petget_compliance_au_view_search_rule" model="ir.ui.view">
        <field name="name">petget.compliance.au.rule.search</field>
        <field name="model">petget.compliance.au.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="state"/>
                <field name="species"/>
                <separator/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_species" string="Species" context="{'group_by': 'species'}"/>
            </search>
        </field>
    </record>

    <record id="petget_compliance_au_view_list_rule" model="ir.ui.view">
        <field name="name">petget.compliance.au.rule.list</field>
        <field name="model">petget.compliance.au.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="state"/>
                <field name="species"/>
                <field name="max_fertile_females"/>
                <field name="max_lifetime_litters"/>
                <field name="max_lifetime_litters_csection"/>
                <field name="min_sale_age_weeks"/>
                <field name="microchip_required_age_weeks"/>
                <field name="breeder_id_required"/>
                <field name="citation" optional="show"/>
            </list>
        </field>
    </record>

    <record id="petget_compliance_au_view_form_rule" model="ir.ui.view">
        <field name="name">petget.compliance.au.rule.form</field>
        <field name="model">petget.compliance.au.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="state"/>
                            <field name="species"/>
                            <field name="active"/>
                        </group>
                        <group string="Limits">
                            <field name="max_fertile_females"/>
                            <field name="max_lifetime_litters"/>
                            <field name="max_lifetime_litters_csection"/>
                            <field name="min_sale_age_weeks"/>
                            <field name="microchip_required_age_weeks"/>
                            <field name="breeder_id_required"/>
                        </group>
                    </group>
                    <group string="Reference">
                        <field name="citation" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="petget_compliance_au_action_rule" model="ir.actions.act_window">
        <field name="name">Compliance Rules (AU)</field>
        <field name="res_model">petget.compliance.au.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="petget_compliance_au_view_search_rule"/>
    </record>

</odoo>
