<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kanban: browse articles with cover image -->
    <record id="petnaly_kb_view_kanban_article" model="ir.ui.view">
        <field name="name">petnaly.kb.article.kanban</field>
        <field name="model">petnaly.kb.article</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row">
                        <field name="published" invisible="1"/>
                        <aside>
                            <field name="image_128" widget="image" options="{'size': [90, 90]}" alt="Cover"/>
                        </aside>
                        <main class="ms-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <div class="text-muted">
                                <field name="category"/>
                                <t t-if="record.breed_id.raw_value"> · <field name="breed_id"/></t>
                            </div>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <div class="small mt-1">
                                <span t-if="record.published.raw_value" class="badge text-bg-success">Published</span>
                                <span t-else="" class="badge text-bg-secondary">Draft</span>
                                <span class="text-muted ms-1"><field name="reading_minutes"/> min read</span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List -->
    <record id="petnaly_kb_view_list_article" model="ir.ui.view">
        <field name="name">petnaly.kb.article.list</field>
        <field name="model">petnaly.kb.article</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="breed_id"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="author_id" optional="hide"/>
                <field name="reading_minutes" optional="hide"/>
                <field name="date_published" optional="show"/>
                <field name="published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="petnaly_kb_view_form_article" model="ir.ui.view">
        <field name="name">petnaly.kb.article.form</field>
        <field name="model">petnaly.kb.article</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object" string="Publish"
                            class="btn-primary" invisible="published"/>
                    <button name="action_unpublish" type="object" string="Unpublish"
                            invisible="not published"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Published" invisible="not published"/>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Article title…"/></h1>
                        <field name="subtitle" placeholder="Optional subtitle…"/>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="species"/>
                            <field name="breed_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="author_id"/>
                            <field name="date_published"/>
                            <field name="reading_minutes"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <separator string="Summary"/>
                    <field name="summary" nolabel="1"
                           placeholder="Short teaser shown in lists and the app…"/>
                    <separator string="Content"/>
                    <field name="body" nolabel="1" placeholder="Write the article…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="petnaly_kb_view_search_article" model="ir.ui.view">
        <field name="name">petnaly.kb.article.search</field>
        <field name="model">petnaly.kb.article</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="breed_id"/>
                <field name="tag_ids"/>
                <filter name="published" string="Published" domain="[('published', '=', True)]"/>
                <filter name="draft" string="Draft" domain="[('published', '=', False)]"/>
                <separator/>
                <filter name="cat_breed" string="Breed Guides" domain="[('category', '=', 'breed')]"/>
                <filter name="cat_care" string="Care &amp; Grooming" domain="[('category', '=', 'care')]"/>
                <filter name="cat_story" string="Stories &amp; Lore" domain="[('category', '=', 'story')]"/>
                <separator/>
                <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                <filter name="group_breed" string="Breed" context="{'group_by': 'breed_id'}"/>
                <filter name="group_species" string="Species" context="{'group_by': 'species'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="petnaly_kb_action_article" model="ir.actions.act_window">
        <field name="name">Articles</field>
        <field name="res_model">petnaly.kb.article</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="petnaly_kb_view_search_article"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Write your first article</p>
            <p>Build a library of breed guides, care tips and stories that help
               owners understand and love their dog.</p>
        </field>
    </record>

</odoo>
