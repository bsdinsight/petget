<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Pet owners (portal users) may only read PUBLISHED articles. -->
        <record id="petnaly_kb_article_rule_portal" model="ir.rule">
            <field name="name">KB: portal reads published articles only</field>
            <field name="model_id" ref="model_petnaly_kb_article"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('published', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
