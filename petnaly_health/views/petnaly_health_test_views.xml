<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="petnaly_health_view_search_test" model="ir.ui.view">
        <field name="name">petnaly.health.test.search</field>
        <field name="model">petnaly.health.test</field>
        <field name="arch" type="xml">
            <search>
                <field name="animal_id"/>
                <field name="test_type"/>
                <field name="report_number"/>
                <filter name="hip_elbow" string="Hip &amp; Elbow" domain="[('test_type', '=', 'hip_elbow')]"/>
                <filter name="dna" string="DNA" domain="[('test_type', '=', 'dna')]"/>
                <separator/>
                <filter name="group_type" string="Type" context="{'group_by': 'test_type'}"/>
                <filter name="group_animal" string="Animal" context="{'group_by': 'animal_id'}"/>
                <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
            </search>
        </field>
    </record>

    <record id="petnaly_health_view_list_test" model="ir.ui.view">
        <field name="name">petnaly.health.test.list</field>
        <field name="model">petnaly.health.test</field>
        <field name="arch" type="xml">
            <list>
                <field name="test_date"/>
                <field name="animal_id"/>
                <field name="test_type"/>
                <field name="dna_marker" optional="hide"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'clear'"
                       decoration-danger="result == 'affected'"
                       decoration-warning="result == 'carrier'"/>
                <field name="hip_score_total"/>
                <field name="breed_average" optional="show"/>
                <field name="report_number" optional="show"/>
            </list>
        </field>
    </record>

    <record id="petnaly_health_view_form_test" model="ir.ui.view">
        <field name="name">petnaly.health.test.form</field>
        <field name="model">petnaly.health.test</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Test">
                            <field name="animal_id"/>
                            <field name="test_type"/>
                            <field name="test_date"/>
                            <field name="result"/>
                            <field name="result_detail"/>
                        </group>
                        <group string="Source">
                            <field name="report_number"/>
                            <field name="provider"/>
                        </group>
                    </group>
                    <group string="Hip &amp; Elbow" invisible="test_type != 'hip_elbow'">
                        <group>
                            <field name="hip_score_left"/>
                            <field name="hip_score_right"/>
                            <field name="hip_score_total"/>
                        </group>
                        <group>
                            <field name="elbow_grade_left"/>
                            <field name="elbow_grade_right"/>
                            <field name="breed_average"/>
                        </group>
                    </group>
                    <group string="DNA / Genetic" invisible="test_type != 'dna'">
                        <field name="dna_marker"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="petnaly_health_action_test" model="ir.actions.act_window">
        <field name="name">Health Tests</field>
        <field name="res_model">petnaly.health.test</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="petnaly_health_view_search_test"/>
    </record>

</odoo>
