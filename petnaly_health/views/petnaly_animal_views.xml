<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="petnaly_health_view_form_animal" model="ir.ui.view">
        <field name="name">petnaly.animal.form.health</field>
        <field name="model">petnaly.animal</field>
        <field name="inherit_id" ref="petnaly_core.petnaly_core_view_form_animal"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_health_tests" type="object"
                        class="oe_stat_button" icon="fa-heartbeat">
                    <field name="health_test_count" widget="statinfo" string="Health Tests"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='registration_number']" position="after">
                <field name="register_type"/>
                <field name="breeding_restricted"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Health" name="health">
                    <group>
                        <group>
                            <field name="has_hip_elbow"/>
                            <field name="latest_hip_score"/>
                        </group>
                    </group>
                    <field name="health_test_ids">
                        <list editable="bottom">
                            <field name="test_date"/>
                            <field name="test_type"/>
                            <field name="result"/>
                            <field name="hip_score_total"/>
                            <field name="breed_average" optional="show"/>
                            <field name="report_number" optional="show"/>
                            <field name="provider" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
