<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="petnaly_compliance_au_view_form_animal" model="ir.ui.view">
        <field name="name">petnaly.animal.form.compliance</field>
        <field name="model">petnaly.animal</field>
        <field name="inherit_id" ref="petnaly_core.petnaly_core_view_form_animal"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="compliance_warning_count" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="compliance_warning_count == 0">
                    <field name="compliance_warning_html"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
