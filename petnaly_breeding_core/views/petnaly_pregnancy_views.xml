<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="petnaly_breeding_view_search_pregnancy" model="ir.ui.view">
        <field name="name">petnaly.pregnancy.search</field>
        <field name="model">petnaly.pregnancy</field>
        <field name="arch" type="xml">
            <search>
                <field name="dam_id"/>
                <filter name="filter_suspected" string="Suspected" domain="[('state', '=', 'suspected')]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_delivered" string="Delivered" domain="[('state', '=', 'delivered')]"/>
                <separator/>
                <filter name="group_dam" string="Dam" context="{'group_by': 'dam_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="petnaly_breeding_view_list_pregnancy" model="ir.ui.view">
        <field name="name">petnaly.pregnancy.list</field>
        <field name="model">petnaly.pregnancy</field>
        <field name="arch" type="xml">
            <list>
                <field name="dam_id"/>
                <field name="confirmation_date"/>
                <field name="confirmation_method" optional="hide"/>
                <field name="expected_due_date"/>
                <field name="puppy_count_estimate" optional="hide"/>
                <field name="actual_birth_date" optional="hide"/>
                <field name="litter_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'suspected'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'delivered'"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="petnaly_breeding_view_form_pregnancy" model="ir.ui.view">
        <field name="name">petnaly.pregnancy.form</field>
        <field name="model">petnaly.pregnancy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'suspected'"/>
                    <button name="action_create_litter" type="object"
                            string="Mark Delivered → Create Litter" class="btn-primary"
                            invisible="state not in ('suspected', 'confirmed')"/>
                    <button name="action_fail" type="object" string="Mark Failed"
                            invisible="state in ('delivered', 'failed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="suspected,confirmed,delivered"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="dam_id"/>
                            <field name="mating_id"/>
                            <field name="species" readonly="1"/>
                        </group>
                        <group>
                            <field name="confirmation_date"/>
                            <field name="confirmation_method"/>
                            <field name="confirmed_by"/>
                            <field name="puppy_count_estimate"/>
                            <field name="expected_due_date"/>
                            <field name="actual_birth_date"/>
                            <field name="litter_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="petnaly_breeding_action_pregnancy" model="ir.actions.act_window">
        <field name="name">Pregnancies</field>
        <field name="res_model">petnaly.pregnancy</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="petnaly_breeding_view_search_pregnancy"/>
    </record>

</odoo>
