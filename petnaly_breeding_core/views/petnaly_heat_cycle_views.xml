<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="petnaly_breeding_view_search_heat_cycle" model="ir.ui.view">
        <field name="name">petnaly.heat.cycle.search</field>
        <field name="model">petnaly.heat.cycle</field>
        <field name="arch" type="xml">
            <search>
                <field name="animal_id"/>
                <filter name="filter_ongoing" string="Ongoing" domain="[('state', '=', 'ongoing')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter name="group_animal" string="Female" context="{'group_by': 'animal_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="petnaly_breeding_view_list_heat_cycle" model="ir.ui.view">
        <field name="name">petnaly.heat.cycle.list</field>
        <field name="model">petnaly.heat.cycle</field>
        <field name="arch" type="xml">
            <list>
                <field name="animal_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_since_previous" optional="show" string="Interval (d)"/>
                <field name="ovulation_date" optional="hide"/>
                <field name="mated_this_cycle" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'ongoing'"
                       decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="petnaly_breeding_view_form_heat_cycle" model="ir.ui.view">
        <field name="name">petnaly.heat.cycle.form</field>
        <field name="model">petnaly.heat.cycle</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_complete" type="object" string="Mark Completed"
                            class="btn-primary" invisible="state == 'completed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Cycle">
                            <field name="animal_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="cycle_length_days"/>
                            <field name="days_since_previous"/>
                        </group>
                        <group string="Breeding Timing">
                            <field name="standing_heat_start"/>
                            <field name="ovulation_date"/>
                            <field name="mated_this_cycle"/>
                            <field name="fit_to_breed"/>
                        </group>
                    </group>
                    <group>
                        <group string="Veterinary">
                            <field name="vet_clearance"/>
                            <field name="vet_clearance_date" invisible="not vet_clearance"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Progesterone Tests" name="progesterone">
                            <p class="text-muted">Track progesterone (ng/mL) to time the optimal mating window.</p>
                            <field name="progesterone_ids">
                                <list editable="bottom">
                                    <field name="test_date"/>
                                    <field name="value_ngml"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Matings" name="matings">
                            <field name="mating_ids" readonly="1">
                                <list>
                                    <field name="mating_date"/>
                                    <field name="sire_id"/>
                                    <field name="external_sire"/>
                                    <field name="pregnancy_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Signs / Symptoms" name="signs">
                            <field name="signs" nolabel="1"
                                   placeholder="Swelling, discharge colour, behaviour, flagging..."/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="petnaly_breeding_action_heat_cycle" model="ir.actions.act_window">
        <field name="name">Heat Cycles</field>
        <field name="res_model">petnaly.heat.cycle</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="petnaly_breeding_view_search_heat_cycle"/>
    </record>

</odoo>
